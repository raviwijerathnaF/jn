+    const q = a.getAttribute('href').split('?')[1];
+    a.href = waHref + (q ? '?' + q : '');
+  });
+  $$('[data-wa-label]').forEach(el => el.textContent = SITE.waLabel);
+  $$('a[href^="mailto:"], [data-email-label]').forEach(el => {
+    if(el.tagName === 'A') el.href = 'mailto:' + SITE.email;
+    el.textContent = SITE.email;
+  });
+})();
+
+/* Logo fallback */
+$$('.logo-mark img').forEach(img => {
+  img.addEventListener('error', () => img.parentNode.classList.add('nologo'));
+});
+
+/* Theme toggle */
+const themeBtn = $('#themeBtn');
+const THEME_COLORS = { dark:'#04172a', light:'#f3f8fc' };
+function paintTheme(theme){
+  const dark = theme !== 'light';
+  document.documentElement.dataset.theme = dark ? 'dark' : 'light';
+  $$('meta[name="theme-color"]').forEach(m => m.setAttribute('content', THEME_COLORS[dark ? 'dark' : 'light']));
+  themeBtn.setAttribute('aria-pressed', String(!dark));
+  const label = dark ? 'Switch to light mode' : 'Switch to dark mode';
+  themeBtn.setAttribute('aria-label', label);
+  themeBtn.setAttribute('title', label);
+}
+themeBtn.addEventListener('click', () => {
+  const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
+  paintTheme(next);
+  try{ localStorage.setItem('omni-theme', next) }catch(e){}
+});
+paintTheme(document.documentElement.dataset.theme);
+
+/* Highlight the service you are reading */
+const subLinks = $$('.subnav a');
+function syncHash(){
+  const h = location.hash || '#web';
+  subLinks.forEach(a => {
+    if(a.getAttribute('href') === h) a.setAttribute('aria-current', 'true');
+    else a.removeAttribute('aria-current');
+  });
+}
+addEventListener('hashchange', syncHash);
+syncHash();
+
+/* Lightweight, cookie-free event hook: pushes to GA4 / Plausible / Clarity when configured */
+function trackEvent(name, params){
+  try{
+    if(typeof window.gtag === 'function') window.gtag('event', name, params || {});
+    if(typeof window.plausible === 'function') window.plausible(name, {props: params || {}});
+    if(typeof window.clarity === 'function') window.clarity('event', name);
+  }catch(e){}
+}
+$$('.blueprint-cta a').forEach(a => a.addEventListener('click', () => {
+  trackEvent('service_cta', {service: a.closest('article') ? a.closest('article').id : 'unknown', target: a.getAttribute('href')});
+}));
+
+$('#copyYear').textContent = new Date().getFullYear();
+</script>
